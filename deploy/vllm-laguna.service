# vllm-laguna.service — systemd USER unit for single-node Laguna-S-2.1-NVFP4 on a
# NVIDIA DGX Spark (GB10).
#
# Install (as the serving user):
#   mkdir -p ~/.config/systemd/user
#   cp ~/laguna-s-2.1/deploy/vllm-laguna.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user start vllm-laguna.service       # manual start
#
# For boot auto-start (service starts without an interactive login session):
#   sudo loginctl enable-linger "$USER"
#   systemctl --user enable vllm-laguna.service
[Unit]
Description=Poolside Laguna S 2.1 August NVFP4 DFlash 96K profile (single-node GB10)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ExecStartPre owns the unit's gate; skip serve.sh's duplicate preflight.
Environment=SKIP_PREFLIGHT=1
# The fork defaults to 0.0.0.0:8888 for trusted LAN/Tailnet clients. Override to
# 127.0.0.1 when the host is not protected by a trusted network or reverse proxy.
#Environment=LAGUNA_HOST=127.0.0.1
ExecStartPre=%h/laguna-s-2.1/deploy/preflight.sh
ExecStart=%h/laguna-s-2.1/deploy/serve.sh
# Post-start primer (non-fatal): health wait + chat/tool/long-prefill probes so the
# first real request doesn't pay JIT/autotune cold costs.
ExecStartPost=-%h/laguna-s-2.1/deploy/warmup.sh
# Fail closed instead of repeatedly reloading a 95.61 GiB model under pressure.
Restart=no
OOMScoreAdjust=500
MemoryHigh=108G
MemoryMax=116G
LimitNOFILE=1048576
KillMode=mixed
# Cold start ≈ 15 min (weights + JIT + graph capture); do not let systemd kill it early.
TimeoutStartSec=1800
TimeoutStopSec=60

[Install]
WantedBy=default.target
